upstream timecampus_backend {
    server 127.0.0.1:8080;
    keepalive 16;
}

server {
    server_name timecampus.asia;

    root /home/ubuntu/TimeCampus-Backend/app/ui;
    index index.html;

    client_max_body_size 25m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    location /api/v1/ {
        proxy_pass http://timecampus_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location /actuator/health {
        proxy_pass http://timecampus_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /swagger-ui/ {
        proxy_pass http://timecampus_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v3/api-docs {
        proxy_pass http://timecampus_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 禁止访问隐藏文件、Git、环境配置
    location ~ /\.(?!well-known) {
         return 404;
    }

    # 拦截常见敏感文件
    location ~* /(composer\.(json|lock)|package-lock\.json|package\.json|yarn\.lock|pnpm-lock\.yaml|Dockerfile|docker-compose\.ya?ml)$ {
        return 404;
    }

    # 项目没有 PHP，直接拒绝所有 PHP 探测
    location ~* \.php$ {
        return 404;
    }

    # WordPress 扫描路径
    location ~* ^/(wp-admin|wp-content|wp-includes|xmlrpc\.php|wp-login\.php) {
        return 404;
    }

    # 环境变量扫描
    location ~* (^|/)\.env {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}


server {
    if ($host = timecampus.asia) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name timecampus.asia;
    return 404; # managed by Certbot


}
