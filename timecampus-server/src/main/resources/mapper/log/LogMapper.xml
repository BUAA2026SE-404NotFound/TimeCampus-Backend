<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.notfound.timecampusserver.mapper.LogMapper">

    <resultMap id="BaseResultMap" type="com.notfound.timecampuspojo.entity.LogEntity">
        <id column="id" property="id"/>
        <result column="operator_type" property="operatorType"/>
        <result column="operator_id" property="operatorId"/>
        <result column="type" property="type"/>
        <result column="action" property="action"/>
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="detail" property="detail"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.notfound.timecampuspojo.entity.LogEntity" useGeneratedKeys="true" keyProperty="id">
        insert into log (operator_type, operator_id, type, action, target_type, target_id, detail, create_time)
        values (#{operatorType}, #{operatorId}, #{type}, #{action}, #{targetType}, #{targetId}, #{detail}, #{createTime})
    </insert>

    <select id="list" resultMap="BaseResultMap">
        select id, operator_type, operator_id, type, action, target_type, target_id, detail, create_time
        from log
        <where>
            <if test="operatorType != null and operatorType != ''">
                and operator_type = #{operatorType}
            </if>
            <if test="type != null and type != ''">
                and type = #{type}
            </if>
            <if test="action != null and action != ''">
                and action = #{action}
            </if>
            <if test="targetType != null and targetType != ''">
                and target_type = #{targetType}
            </if>
        </where>
        order by create_time desc, id desc
        limit #{limit}
    </select>
</mapper>
